{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hexsecs.github.io/openshelf/schemas/page.schema.json",
  "title": "OpenShelf page frontmatter",
  "description": "A page's id is its path under layout.pages without .md, so it is not a frontmatter field; its persistent uid (§4.1) is one. Profile rules (such as awesome entities needing url and category) depend on kb.yaml and are checked by lint, not by this schema.",
  "type": "object",
  "oneOf": [
    { "required": ["title", "summary"], "not": { "required": ["redirect"] } },
    { "required": ["redirect"] }
  ],
  "properties": {
    "uid": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$" },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1, "maxLength": 160 },
    "type": { "type": "string", "minLength": 1 },
    "updated": { "type": "string", "format": "date" },
    "created": { "type": "string", "format": "date" },
    "depth": { "enum": ["stub", "brief", "full", "deep"] },
    "sources": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string" },
          {
            "type": "object",
            "properties": {
              "url": { "type": "string" },
              "path": { "type": "string" },
              "retrieved": { "type": "string", "format": "date" },
              "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" }
            },
            "anyOf": [{ "required": ["url"] }, { "required": ["path"] }]
          }
        ]
      }
    },
    "redirect": { "type": "string", "minLength": 1 },
    "url": { "type": "string" },
    "category": { "type": "string" },
    "license": { "type": "string" },
    "status": { "enum": ["active", "maintenance", "archived", "published", "unknown"] },
    "last_checked": { "type": "string", "format": "date" }
  },
  "additionalProperties": true
}
